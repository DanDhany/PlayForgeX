{
  "name": "tunebridge",
  "version": "1.0.0",
  "type": "module",
  "description": "TuneBridge — Universal Music Library & Migration Hub with original title priority and zero developer account requirement",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "tsc && BUILD_TARGET=web vite build",
    "server": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "auth:yt": "node scripts/auto-catch.js youtube",
    "auth:yt:clean": "node scripts/auto-catch.js youtube --clean",
    "auth:apple": "node scripts/auto-catch.js apple",
    "auth:add": "node scripts/auto-catch.js",
    "auth:reset": "node scripts/auto-catch.js reset",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.24.6",
    "puppeteer-core": "^25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.7"
  }
}
